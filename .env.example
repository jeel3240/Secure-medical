NODE_ENV=development
DATABASE_URL=postgres://app:app@postgres:5432/leads
REDIS_URL=redis://redis:6379
# Any value works locally. In production it must be at least 32 characters
# and not a placeholder, or the API refuses to start: openssl rand -hex 32
JWT_SECRET=change-me

EZT_USERNAME=<sandbox-username>
EZT_PASSWORD=<sandbox-password>

# Contact group the poller reads. Required: the account holds ~120k real
# contacts, so every query is scoped to one group.
EZT_GROUP=weightloss

# Partner leads arrive as API. Contacts added by hand in the EZ Texting
# dashboard arrive as WebInterface, so set this to WebInterface to test with
# a contact you added yourself. Defaults to API.
EZT_SOURCE=API

# Group allowed to receive SMS. Leave unset and sendMessage refuses to send:
# this is a live account and CLAUDE.md permits sending only to a dev-test
# group of our own phones.
# Update 2026-09-14: the account is a test account and weightloss is the test
# group. Test settings: EZT_GROUP=weightloss, EZT_SOURCE=WebInterface,
# EZT_SEND_GROUP=weightloss.
EZT_SEND_GROUP=

# Random string forming the last segment of the inbound webhook path:
# /api/webhooks/eztexting/<token>. EZ Texting sends no signature header, so an
# unguessable URL is the only check on who is posting. Unset accepts the plain
# path, which is convenient locally. Production refuses to start without one
# of at least 16 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
EZT_WEBHOOK_TOKEN=

# --- Twilio: browser calling, Phase 4 - docs/TWILIO.md. Leave all empty to keep calling off. ---
# All seven are empty here on purpose: a straight copy of this file runs with
# calling off. Fill in all seven or none - some but not all is "set up partly",
# which is off locally with a warning and stops the API starting in production.
# Account SID (AC...) and auth token: Twilio Console home page. The token also
# checks that requests to our voice webhooks really come from Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# API key (SK...) and secret: Console > Account > API keys & tokens > Create API
# key, Standard. They sign the short-lived token a browser calls with. The
# secret is shown once.
TWILIO_API_KEY=
TWILIO_API_SECRET=
# TwiML App (AP...): Console > Voice > TwiML Apps. Its Voice URL is our
# /api/webhooks/twilio/voice route - Twilio asks it how to connect each call.
TWILIO_TWIML_APP_SID=
# Voice-capable number leads see when called, E.164.
TWILIO_PHONE_NUMBER=
# This app's public https address, no trailing slash. Twilio's webhooks are
# signed against it, and `npm run twilio:configure` points the TwiML App and the
# phone number at it. The number rings only one address: after testing locally
# with it, run twilio:configure on the server again.
# Production: https://dailyleadhub.com. Locally: your tunnel's address.
PUBLIC_URL=

# Not read by anything: the production Caddyfile names dailyleadhub.com directly.
CADDY_DOMAIN=localhost
