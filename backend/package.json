{
  "name": "secure-medical-backend",
  "version": "1.0.0",
  "description": "Medical call center lead qualification system",
  "main": "dist/api/index.js",
  "scripts": {
    "build": "tsc",
    "api": "node dist/api/index.js",
    "worker": "node dist/worker/index.js",
    "dev:api": "ts-node src/api/index.ts",
    "dev:worker": "ts-node src/worker/index.ts",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:worker\"",
    "migrate": "node scripts/migrate.js",
    "test": "jest"
  },
  "dependencies": {
    "axios": "^1.4.0",
    "bcrypt": "^5.1.0",
    "bull": "^4.11.0",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0",
    "pg": "^8.11.0",
    "redis": "^4.6.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/express": "^4.17.0",
    "@types/jest": "^29.5.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.23.1",
    "concurrently": "^8.2.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  }
}
