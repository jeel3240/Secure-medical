{
  "name": "secure-medical-backend",
  "version": "1.0.0",
  "description": "Medical call center lead qualification system",
  "main": "dist/api/index.js",
  "scripts": {
    "build": "tsc",
    "api": "node dist/api/index.js",
    "worker": "node dist/worker/index.js",
    "dev:api": "ts-node src/api/index.ts",
    "dev:worker": "ts-node src/worker/index.ts",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:worker\"",
    "migrate": "node scripts/migrate.js",
    "create-superadmin": "node dist/cli/create-superadmin.js",
    "dev:create-superadmin": "ts-node src/cli/create-superadmin.ts",
    "test": "jest",
    "e2e": "ts-node --transpile-only scripts/end-to-end.ts",
    "lint": "eslint src scripts"
  },
  "dependencies": {
    "axios": "^1.4.0",
    "bcrypt": "^5.1.0",
    "cookie-parser": "^1.4.7",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "jsonwebtoken": "^9.0.0",
    "pg": "^8.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bcrypt": "^5.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.0",
    "@types/jest": "^29.5.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "concurrently": "^8.2.0",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "jest": "^29.5.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.71.0"
  }
}
